CREATE TABLE users (id INT PRIMARY KEY, name VARCHAR(40), email VARCHAR(60), wallet INT NOT NULL) ENGINE=CELLTNX;
INSERT INTO users VALUES (1, 'ann', 'a@x', 10), (2, 'bob', 'b@x', 20);
# Scenario 2: con1 read A.email; con2 writes A.email and commits first.
BEGIN;
SELECT email FROM users WHERE id = 1;
email
a@x
UPDATE users SET name = 'x' WHERE id = 2;
UPDATE users SET email = 'q@x' WHERE id = 1;
COMMIT;
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
SHOW WARNINGS;
Level	Code	Message
Error	1213	Deadlock found when trying to get lock; try restarting transaction
Error	1180	Got error 149 - 'Lock deadlock; Retry transaction' during COMMIT
# The failed transaction's write is gone and the session continues.
SELECT * FROM users ORDER BY id;
id	name	email	wallet
1	ann	q@x	10
2	bob	b@x	20
UPDATE users SET name = 'y' WHERE id = 2;
SELECT name FROM users WHERE id = 2;
name
y
# Two transactions read and rewrite one cell: the second to commit conflicts.
BEGIN;
SELECT wallet FROM users WHERE id = 1;
wallet
10
BEGIN;
SELECT wallet FROM users WHERE id = 1;
wallet
10
UPDATE users SET wallet = 11 WHERE id = 1;
UPDATE users SET wallet = 12 WHERE id = 1;
COMMIT;
COMMIT;
ERROR 40001: Deadlock found when trying to get lock; try restarting transaction
SELECT wallet FROM users WHERE id = 1;
wallet
12
DROP TABLE users;
